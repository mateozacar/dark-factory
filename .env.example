# Dark Factory — example environment variables
# Copy this file to .env and adjust values as needed.
# .env is never committed to source control.

# USGS FDSNWS API base URL.
# Default: public USGS earthquake endpoint (no API key required).
# Override in tests or when pointing at a mock/staging server.
USGS_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
